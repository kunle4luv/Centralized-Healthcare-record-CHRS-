# API Base URL for the backend
# Change this to your production URL when deploying
VITE_API_URL=http://localhost:3001

# AI Backend Configuration
# Choose 'ollama' for FREE local AI or 'openai' for cloud AI (requires API key)
VITE_AI_BACKEND=ollama

# Ollama Configuration (for FREE local AI)
# Available models: meditron:7b, llama3.2:3b, mistral:7b, phi3:3.8b
VITE_OLLAMA_MODEL=llama3.2:3b
VITE_OLLAMA_BASE_URL=http://localhost:11434

# OpenAI API Key for AI medical recommendations (only needed if using openai backend)
# Get your API key from https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Development: Set to 'true' to use mock responses when AI services are unavailable
VITE_USE_MOCK_AI=false
